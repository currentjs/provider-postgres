{
  "name": "@currentjs/provider-postgres",
  "version": "0.1.1",
  "description": "PostgreSQL provider for currentjs",
  "license": "LGPL-3.0-or-later",
  "author": "Konstantin Zavalny",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist dist-test",
    "prepack": "npm run build",
    "test:build": "tsc -p tsconfig.test.json",
    "test": "npm run test:build && node --test dist-test/tests/unit/*.test.js",
    "test:all": "npm run test:build && node --test dist-test/tests/unit/*.test.js dist-test/tests/integration/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "pg": "^8.11.0",
    "@currentjs/provider": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.10.0",
    "typescript": "^5.6.3"
  }
}
